@echo off
setlocal

where node >nul 2>nul
if errorlevel 1 (
  echo.
  echo This tool needs Node.js to run, and it is not installed on this computer.
  echo.
  echo Node.js is a free program that runs this tool. You install it once.
  echo.
  echo   Easiest:  open https://nodejs.org and click the green "LTS" button,
  echo             then run the installer.
  echo   Or, in a terminal:  winget install OpenJS.NodeJS.LTS
  echo.
  echo After that, run this script again.
  echo.
  pause
  exit /b 1
)

for /f "delims=" %%v in ('node -p "process.versions.node.split('.')[0]"') do set NODE_MAJOR=%%v
if %NODE_MAJOR% LSS 18 (
  echo.
  echo This tool needs Node.js version 18 or newer.
  echo This computer has version:
  node -v
  echo.
  echo Install the "LTS" version from https://nodejs.org over the one you have,
  echo then run this script again.
  echo.
  pause
  exit /b 1
)

set "APP_DIR=%USERPROFILE%\.tokenharbor-registrar"
if not exist "%APP_DIR%" mkdir "%APP_DIR%"

powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText('%~f0'); $i=$s.LastIndexOf('__TH_PAYLOAD_B64__'); if($i -lt 0){ exit 2 }; $b=$s.Substring($i+18) -replace '\s',''; $t=Join-Path $env:TEMP ([Guid]::NewGuid().ToString()); [IO.File]::WriteAllBytes($t,[Convert]::FromBase64String($b)); Move-Item -Force $t (Join-Path $env:APP_DIR 'run_headless.js')"
if errorlevel 1 (
  echo.
  echo This file looks damaged - the part inside it could not be read.
  echo Download the script again and run it once more.
  echo.
  pause
  exit /b 1
)

if not exist "%APP_DIR%\node_modules\playwright" (
  where npm >nul 2>nul
  if errorlevel 1 (
    echo.
    echo This tool needs the "npm" command, which comes with Node.js, and it is missing.
    echo.
    echo Reinstall the "LTS" version from https://nodejs.org, then run this script again.
    echo.
    pause
    exit /b 1
  )
  echo.
  echo One-time setup: downloading a small helper (about 40 MB). This runs once.
  echo.
  call :install_playwright
  if not exist "%APP_DIR%\node_modules\playwright" (
    echo.
    echo The download failed. This is almost always a temporary internet problem.
    echo.
    echo Check that this computer is online, then run this script again.
    echo.
    pause
    exit /b 1
  )
  echo.
  echo Setup finished.
)

rem Anything after the script name is passed straight through, so the launcher can do the whole
rem tool's work: "this-file --warp down" closes the tunnel, "this-file --bulk 5 --now" runs the
rem engine. No argument at all means the wizard, which is what the file is for.
set "TH_SELF=%~f0"
if "%~1"=="" (
  node "%APP_DIR%\run_headless.js" --wizard
) else (
  node "%APP_DIR%\run_headless.js" %*
)
echo.
pause
exit /b 0

REM Only one launcher may install at a time: two starting together on a fresh computer would
REM both write into the same node_modules. Creating a directory is the atomic way to claim it.
:install_playwright
mkdir "%APP_DIR%\.npm-lock" 2>nul
if errorlevel 1 (
  echo Another copy of this tool is fetching it right now; waiting for that one.
  for /l %%i in (1,1,150) do (
    if exist "%APP_DIR%\node_modules\playwright" exit /b 0
    ping -n 3 127.0.0.1 >nul 2>nul
  )
  exit /b 0
)
pushd "%APP_DIR%"
call npm install --no-fund --no-audit --loglevel=error playwright
popd
rmdir "%APP_DIR%\.npm-lock" 2>nul
exit /b 0
