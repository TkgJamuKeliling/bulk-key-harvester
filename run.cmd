@echo off
setlocal

where node >nul 2>nul
if errorlevel 1 (
  echo.
  echo This tool needs Node.js to run, and it is not installed on this computer.
  echo.
  echo Node.js is a free program that runs this tool. You install it once.
  echo.
  echo   Easiest:  open https://nodejs.org and click the green "LTS" button,
  echo             then run the installer.
  echo   Or, in a terminal:  winget install OpenJS.NodeJS.LTS
  echo.
  echo After that, run this script again.
  echo.
  pause
  exit /b 1
)

for /f "delims=" %%v in ('node -p "process.versions.node.split('.')[0]"') do set NODE_MAJOR=%%v
if %NODE_MAJOR% LSS 18 (
  echo.
  echo This tool needs Node.js version 18 or newer.
  echo This computer has version:
  node -v
  echo.
  echo Install the "LTS" version from https://nodejs.org over the one you have,
  echo then run this script again.
  echo.
  pause
  exit /b 1
)

set "APP_DIR=%USERPROFILE%\.tokenharbor-registrar"
if not exist "%APP_DIR%" mkdir "%APP_DIR%"

powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText('%~f0'); $i=$s.LastIndexOf('__TH_PAYLOAD_B64__'); if($i -lt 0){ exit 2 }; $b=$s.Substring($i+18) -replace '\s',''; [IO.File]::WriteAllBytes((Join-Path $env:APP_DIR 'run_headless.js'),[Convert]::FromBase64String($b))"
if errorlevel 1 (
  echo.
  echo This file looks damaged - the part inside it could not be read.
  echo Download the script again and run it once more.
  echo.
  pause
  exit /b 1
)

if not exist "%APP_DIR%\node_modules\playwright" (
  where npm >nul 2>nul
  if errorlevel 1 (
    echo.
    echo This tool needs the "npm" command, which comes with Node.js, and it is missing.
    echo.
    echo Reinstall the "LTS" version from https://nodejs.org, then run this script again.
    echo.
    pause
    exit /b 1
  )
  echo.
  echo One-time setup: downloading a small helper (about 40 MB). This runs once.
  echo.
  pushd "%APP_DIR%"
  call npm install --no-fund --no-audit --loglevel=error playwright
  popd
  if not exist "%APP_DIR%\node_modules\playwright" (
    echo.
    echo The download failed. This is almost always a temporary internet problem.
    echo.
    echo Check that this computer is online, then run this script again.
    echo.
    pause
    exit /b 1
  )
  echo.
  echo Setup finished.
)

node "%APP_DIR%\run_headless.js" --wizard
echo.
pause
exit /b 0
